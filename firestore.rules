rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /products/{productId} {
      allow read, write: if isValidId(productId);
    }

    match /tables/{tableId} {
      allow read, write: if isValidId(tableId);
    }

    match /orders/{orderId} {
      allow read, write: if isValidId(orderId);
    }

    match /paymentRecords/{paymentRecordId} {
      allow read, write: if isValidId(paymentRecordId);
    }

    match /printJobs/{printJobId} {
      allow read, write: if isValidId(printJobId);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
